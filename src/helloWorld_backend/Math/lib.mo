module {
    public class Math() {
        public func add(x : Int, y : Int) : async Int {
            return x + y;
        };

        public func sub(x : Int, y : Int) : async Int {
            return x - y;
        };
        public func mul(x : Int, y : Int) : async Int {
            return x * y;
        };
    };
};
